<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <!-- Change this connection string to match your local SQL Server instance (e.g., localhost, (localdb)\MSSQLLocalDB, or SQLEXPRESS) -->
    <add name="DefaultConnection"
         connectionString="Server=localhost;Database=LabTestDB;Integrated Security=True;TrustServerCertificate=True;"
         providerName="Microsoft.Data.SqlClient" />
  </connectionStrings>
</configuration>
